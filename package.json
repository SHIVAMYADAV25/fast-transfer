{
  "name": "fast-transfer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter @fast-transfer/web dev",
    "dev:signaling": "pnpm --filter @fast-transfer/signaling dev",
    "dev:desktop": "pnpm --filter @fast-transfer/desktop dev",
    "dev:mobile": "pnpm --filter @fast-transfer/mobile start",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @fast-transfer/web build",
    "build:desktop": "pnpm --filter @fast-transfer/desktop build",
    "dev:landing": "pnpm --filter @fast-transfer/landingpage dev",
    "build:landing": "pnpm --filter @fast-transfer/landingpage build"
  }
}
