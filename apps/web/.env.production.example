# Used for BOTH the production Vercel deployment (`next build`) and the
# desktop app's static export (`next build:desktop`, invoked by Tauri —
# see apps/desktop/src-tauri/tauri.conf.json's beforeBuildCommand).
#
# Copy this to `.env.production` and point it at your deployed signaling
# Worker before running `pnpm build:desktop` — a static export bakes
# these values in at build time, they can't be changed at runtime like
# they can in local dev.
NEXT_PUBLIC_SIGNALING_HTTP_URL=https://kimo-signaling.<you>.workers.dev
NEXT_PUBLIC_SIGNALING_WS_URL=wss://kimo-signaling.<you>.workers.dev
NEXT_PUBLIC_APP_URL=https://your-kimo-domain.example.com

# Optional — see /docs/turn-server.md for how to stand up a TURN server.
# NEXT_PUBLIC_TURN_URLS=turn:your.turn.server:3478
# NEXT_PUBLIC_TURN_USERNAME=kimo
# NEXT_PUBLIC_TURN_CREDENTIAL=your-long-random-secret
