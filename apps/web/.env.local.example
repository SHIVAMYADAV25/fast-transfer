# Point these at your running signaling worker.
# Local dev default (wrangler dev): http://localhost:8787 / ws://localhost:8787
NEXT_PUBLIC_SIGNALING_HTTP_URL=http://localhost:8787
NEXT_PUBLIC_SIGNALING_WS_URL=ws://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — see /docs/turn-server.md for how to stand up a TURN server.
# Leave unset to run STUN-only (direct P2P, no relay fallback).
# NEXT_PUBLIC_TURN_URLS=turn:your.turn.server:3478
# NEXT_PUBLIC_TURN_USERNAME=fasttransfer
# NEXT_PUBLIC_TURN_CREDENTIAL=your-long-random-secret
